# =============================================================
# lab_ransomware.rules — Reglas Snort para el laboratorio
# Laboratorio: IDS y Detección de Ransomware en Kali Linux
# =============================================================
# Cómo usarlas con Snort:
#   sudo snort -i eth0 -A fast -l /var/log/snort \
#        -c /etc/snort/snort.conf -R /ruta/a/lab_ransomware.rules
# =============================================================

# ─── RETO 1: Descarga del archivo de prueba EICAR ─────────────
# Detecta la cadena X5O!P al inicio del payload (firma EICAR)
alert tcp $EXTERNAL_NET any -> $HOME_NET any \
  (msg:"[LAB] Descarga archivo EICAR - Test malware detectado"; \
   content:"X5O!P%@AP[4"; nocase; \
   classtype:trojan-activity; sid:9000001; rev:1;)

# Detecta el nombre del archivo falso "Factura_Urgente"
alert tcp $EXTERNAL_NET any -> $HOME_NET any \
  (msg:"[LAB] Posible malware - Factura_Urgente descargada"; \
   content:"Factura_Urgente"; nocase; http_uri; \
   classtype:trojan-activity; sid:9000002; rev:1;)

# ─── RETO 2: Tráfico de Beacon / C2 ──────────────────────────
# Detecta User-Agent del simulador IOC
alert tcp $HOME_NET any -> $EXTERNAL_NET any \
  (msg:"[LAB] Beacon C2 detectado - LabRansomSim"; \
   content:"LabRansomSim"; http_header; nocase; \
   classtype:command-and-control; sid:9000003; rev:1;)

# Detecta la ruta /beacon en peticiones HTTP
alert tcp $HOME_NET any -> $EXTERNAL_NET any \
  (msg:"[LAB] Ransomware C2 - Ruta /beacon detectada"; \
   content:"GET /beacon"; nocase; \
   classtype:command-and-control; sid:9000004; rev:1;)

# Detecta check al kill switch (equivale al C2 WannaCry)
alert tcp $HOME_NET any -> $EXTERNAL_NET any \
  (msg:"[LAB] Ransomware C2 - Consulta kill switch"; \
   content:"GET /killswitch"; nocase; \
   classtype:command-and-control; sid:9000005; rev:1;)

# ─── RETO 3: Descarga de script PowerShell sospechoso ────────
alert tcp $EXTERNAL_NET any -> $HOME_NET any \
  (msg:"[LAB] Descarga de script PowerShell sospechoso (.ps1)"; \
   content:".ps1"; nocase; http_uri; \
   classtype:trojan-activity; sid:9000006; rev:1;)

# ─── RETO 4: Puerto no estándar usado por el C2 ──────────────
# El panel C2 de práctica usa el puerto 4444 (común en C2 reales)
alert tcp any any -> $EXTERNAL_NET 4444 \
  (msg:"[LAB] Conexion saliente a puerto 4444 - posible C2"; \
   classtype:command-and-control; sid:9000007; rev:1;)

# El servidor malicioso usa el puerto 8080
alert tcp $EXTERNAL_NET 8080 -> $HOME_NET any \
  (msg:"[LAB] Descarga desde servidor en puerto 8080"; \
   classtype:trojan-activity; sid:9000008; rev:1;)

# ─── RETO 5 (BONUS): Patrón de renombrado masivo (.locked) ───
# Snort no ve el sistema de archivos, pero sí tráfico SMB/NFS.
# Esta regla detecta el nombre "LEEME_RESCATE" en tráfico de red.
alert tcp any any -> any any \
  (msg:"[LAB] BONUS - Posible nota de rescate en tráfico de red"; \
   content:"LEEME_RESCATE"; nocase; \
   classtype:trojan-activity; sid:9000009; rev:1;)
